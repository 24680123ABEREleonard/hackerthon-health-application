<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fieldnote.Mobile.MainPage"
             BackgroundColor="#F4F7F6">
    <ContentPage.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#698078" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="20,16,20,12" ColumnDefinitions="*,Auto" BackgroundColor="White">
            <VerticalStackLayout Spacing="2">
                <Label Text="fieldnote." FontSize="23" FontAttributes="Bold" TextColor="#26383B" />
                <Label Text="KIJANI HEALTH CENTRE" FontSize="9" CharacterSpacing="1.2" TextColor="#83918D" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Stroke="#E6EEEA" BackgroundColor="#F9FBFA" StrokeShape="RoundRectangle 16" Padding="10,6" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="7">
                    <Ellipse WidthRequest="7" HeightRequest="7" Fill="#60A481" VerticalOptions="Center" />
                    <Label Text="LOCAL SQLITE" FontSize="9" CharacterSpacing=".4" TextColor="#60766B" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="PageBody" Padding="18,12,18,24" Spacing="15" />
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Padding="6,6,6,10" BackgroundColor="White">
            <Button Grid.Column="0" Text="Home" Clicked="OnHomeClicked" Style="{StaticResource TabButton}" />
            <Button Grid.Column="1" Text="Cases" Clicked="OnCasesClicked" Style="{StaticResource TabButton}" />
            <Button Grid.Column="2" Text="AI help" Clicked="OnAssistantClicked" Style="{StaticResource TabButton}" />
            <Button Grid.Column="3" Text="Settings" Clicked="OnSettingsClicked" Style="{StaticResource TabButton}" />
        </Grid>
    </Grid>
</ContentPage>
